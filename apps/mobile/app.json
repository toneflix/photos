{
  "expo": {
    "name": "Toneflix Photos",
    "slug": "toneflix-photos",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toneflix.photos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEBB00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.toneflix.photos.app",
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "scheme": "toneflixphotos",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-media-library",
        {
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon-ios.png",
          "imageWidth": 260,
          "backgroundColor": "#EEBB00",
          "android": {
            "mdpi": "./assets/splash/splash-icon-mdpi.png",
            "hdpi": "./assets/splash/splash-icon-hdpi.png",
            "xhdpi": "./assets/splash/splash-icon-xhdpi.png",
            "xxhdpi": "./assets/splash/splash-icon-xxhdpi.png",
            "xxxhdpi": "./assets/splash/splash-icon-xxxhdpi.png"
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "dbae05c1-d604-4b44-bb1d-1fd9dc28a0b8"
      }
    }
  }
}
