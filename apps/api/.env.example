APP_NAME="Toneflix Photos"
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000
APP_PORT=3000
APP_HOST=localhost
# Where photos are stored. Use "local" in development and "s3" (any S3-compatible
# bucket, e.g. Cloudflare R2 or AWS S3) in production. Configured in src/config/filesystem.ts.
FILESYSTEM_DISK=local

CACHE_STORE=memory
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

APP_KEY=
JWT_EXPIRES_IN=30d

NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxx

DATABASE_URL="postgres://postgres:postgres@localhost:5432/toneflix_photos?schema=public"
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toneflix_photos
DB_USERNAME=postgres
DB_PASSWORD=postgres

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_TEST_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
# Disk for uploaded photos. Defaults to the local `public` disk (served by the API
# under /photos). In production use an S3-compatible bucket, e.g. PHOTOS_DISK=s3.
PHOTOS_DISK=
# Originals over this many megabytes are compressed until they fit.
PHOTOS_MAX_ORIGINAL_MB=5
# The WebP copy shown in the app: longest side in pixels, and quality (1-100).
PHOTOS_DISPLAY_MAX_EDGE=2048
PHOTOS_DISPLAY_QUALITY=80

PRINT_CHROMIUM_PATH=
PRINT_PAGE_WIDTH_MM=210
PRINT_PHOTO_MAX_EDGE=3300
PRINT_IMAGE_DPI=300
PRINT_TIMEOUT=180

# Defaults for settings admins can change in the dashboard. A value saved there wins over these.
UPLOADS_MAX_PHOTO_MB=25
UPLOADS_MAX_AVATAR_MB=10
REGISTRATION_OPEN=true
DEFAULT_LICENSE=all-rights-reserved
DEFAULT_BOOK_VISIBILITY=private
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_LOCKOUT_MINUTES=15
ACCESS_CODE_MAX_GUESSES=20
BOOKS_MAX_PAGES=500
BOOK_KICKER="A Toneflix photobook"
BOOK_IMPRINT="Toneflix Photos"
BOOK_COLOPHON="Made with Toneflix Photos."
# Seconds each API process keeps saved settings before reading them again.
SETTINGS_CACHE_SECONDS=60

# Proxies allowed to report the visitor's IP in X-Forwarded-For (rate limits key on it):
# a hop count such as 1, or their addresses/CIDRs. false trusts none.
TRUST_PROXY=false

# Payments for plans, through Flutterwave's hosted checkout. The webhook hash is the
# secret hash set under Webhooks in the Flutterwave dashboard.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_REFERENCE_PREFIX=tfp_
# The secret the payment relay holds for Photos. Once set, webhooks are accepted only from the relay.
PAYMENT_RELAY_SECRET=
PAYMENT_RELAY_APP=photos
# Live exchange rates (@toneflix/money) for payment regions without a fixed rate:
# frankfurter or exchangerate-api (with EXCHANGERATE_API_KEY). Kept for EXCHANGE_RATE_HOURS.
EXCHANGE_RATES_PROVIDER=frankfurter
EXCHANGERATE_API_KEY=
EXCHANGE_RATE_HOURS=6
