{
  "name": "toneflix-photos",
  "private": true,
  "description": "Toneflix Photos: a digital photo book for preserving photos for all time.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @photos/api dev",
    "dev:web": "pnpm --filter @photos/web dev",
    "dev:mobile": "pnpm --filter @photos/mobile start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  }
}
